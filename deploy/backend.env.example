# Backend host secrets only. Do not put these in VITE_* variables.
NODE_ENV=production
API_HOST=0.0.0.0
# Host-provided PORT takes precedence over API_PORT.
API_PORT=3001
WEB_URL=https://trello.example.com
# Public browser origin: OAuth requests/callbacks also pass through the frontend proxy.
API_URL=https://trello.example.com
FRONTEND_URL=https://trello.example.com
DATABASE_URL=postgresql://ROLE:PASSWORD@HOST-pooler/trello?sslmode=require
DATABASE_MIGRATION_URL=postgresql://ROLE:PASSWORD@HOST/trello?sslmode=require
DB_POOL_MAX=5
JWT_SECRET=REPLACE_WITH_NEW_RANDOM_64_HEX_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_NEW_RANDOM_64_HEX_CHAR_SECRET
STORAGE_BACKEND=s3
S3_ENDPOINT=https://YOUR_S3_ENDPOINT
S3_REGION=YOUR_REGION
S3_BUCKET=trello-attachments
S3_ACCESS_KEY_ID=REPLACE_IN_HOST_SECRET_SETTINGS
S3_SECRET_ACCESS_KEY=REPLACE_IN_HOST_SECRET_SETTINGS
S3_PUBLIC_URL=https://YOUR_FILE_DELIVERY_HOST
# Optional: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, RESEND_API_KEY, FROM_EMAIL.
